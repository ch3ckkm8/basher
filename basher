#!/usr/bin/env bash

# basher - a simple key-value store
# Usage:
#   source basher <varname> <value> [ColumnName]  # set a variable (and export it)
#                                                  # optional [ColumnName] (must be
#                                                  # wrapped in brackets) sets the
#                                                  # header used for it in --table.
#                                                  # Pass [notable] instead to still
#                                                  # save & export the variable, but
#                                                  # hide it from --table entirely.
#   source basher <varname>           # get a variable
#   source basher --list              # list all variables (also exports them into the shell)
#   source basher --table             # display all variables as a table (also exports them into the shell)
#   source basher --table <index>     # show only the variables grouped under that index
#                                      # (creds1_2 counts as sub-index of index "1")
#   source basher --per-index         # display one mini-table per index, all in one go
#   source basher --delete <varname>  # delete a variable
#   source basher --clear             # clear all variables
#   source basher --load              # export all stored variables into current shell
#
# TIP: Add this to your ~/.bashrc for easy use:
#   alias basher='source /path/to/basher'

